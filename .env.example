# Public frontend values plus deployment (server) environment placeholders.
# Only Vite-prefixed keys reach the browser. Copy real values into .env.local;
# never commit a real value. Server keys belong in the Functions deployment.
VITE_APP_NAME="ScanGo"

# Firebase web app configuration for project scango-8f0e9.
# Copy real values into .env.local. Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Run Cloud Functions locally while Auth and Firestore stay on the real project.
# Run `npm run emulators` first, then set this flag to true and restart Vite.
VITE_USE_FUNCTIONS_EMULATOR=false

# Point Firebase Storage at the local Storage emulator. This is separate from
# VITE_USE_FUNCTIONS_EMULATOR because `npm run emulators` starts Functions only:
# set this only when the Storage emulator is also running, for example
#   firebase emulators:start --only functions,storage
# With the flag off, product-feedback screenshots upload to the real bucket and
# need the deployed Storage Rules (REQ-FDB-005).
VITE_USE_STORAGE_EMULATOR=false

# Frontend error monitoring (NFR-OBS-001). Leave blank to disable Sentry.
# The DSN is public-by-design and is never logged with user data.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_APP_RELEASE=

# Cloud Functions server monitoring reads SENTRY_DSN, SENTRY_ENVIRONMENT, and
# SENTRY_RELEASE from the Functions runtime environment. Never commit a real
# value; set it through deployment configuration.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
