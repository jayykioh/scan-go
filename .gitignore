node_modules/
build/
dist/
coverage/
functions/lib/
.firebase/
firebase-debug.log
.DS_Store
*.log
.env*
!.env.example

# Local secret values for the Functions emulator. Never commit.
.secret.local
**/.secret.local

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Browser automation artifacts and the npm cache the CLI creates next to them.
# Both are regenerable local state, never source.
/.playwright-cli/
/.pw-cache/

# Optional local Firebase emulator jar cache, for hosts where the CLI cannot
# write to ~/.cache/firebase/emulators. Point FIREBASE_EMULATORS_PATH here.
/.emu-cache/
