rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTenantMember(tenantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    // Public projections contain no private tenant or Customer fields.
    match /publicTableLinks/{token} {
      allow get: if resource.data.active == true;
      allow list, create, update, delete: if false;
    }

    match /tenants/{tenantId}/publicMenuItems/{itemId} {
      allow read: if resource.data.tenantId == tenantId && resource.data.available == true;
      allow write: if false;
    }

    match /publicOrderTracking/{trackingToken} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Authorized staff may read queues; all business writes go through Cloud Functions.
    match /tenants/{tenantId}/orders/{orderId} {
      allow read: if isTenantMember(tenantId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
