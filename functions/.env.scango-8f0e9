# Deploy-time environment for the scango-8f0e9 project.
#
# ADR 0017: App Check enforcement is temporarily off because the web client does
# not initialize App Check yet, so every callable would reject a real browser
# with `failed-precondition`. `functions/src/shared/appCheck.ts` still enforces
# by default; this file only opts this deployment out. Delete this line once the
# client sends a token.
ENFORCE_APP_CHECK=false

# This file holds deployment flags only. Never put a secret here: these values
# are injected into every function in the codebase. Secrets belong in Secret
# Manager (see functions/src/shared/secrets.ts).
